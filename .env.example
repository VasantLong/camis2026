# PostgreSQL
POSTGRES_USER=docapp
POSTGRES_PASSWORD=secret_pg_pwd
POSTGRES_DB=doc_metadata
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://docapp:secret_pg_pwd@postgres:5432/doc_metadata

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=company-docs

# Redis
REDIS_PASSWORD=secret_redis_pwd
REDIS_URL=redis://:secret_redis_pwd@redis:6379/0
